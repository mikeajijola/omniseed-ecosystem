{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseed.org/schemas/conformance-report-v1.json",
  "title": "OmniSeed Ecosystem Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["ecosystemVersion", "generatedAt", "reportKind", "freshness", "subjectState", "governance", "repositories", "summary", "findings"],
  "properties": {
    "ecosystemVersion": { "type": "string", "const": "1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "reportKind": { "enum": ["mainline", "candidate"] },
    "freshness": { "enum": ["current", "stale", "candidate", "indeterminate"] },
    "subjectState": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "invariantDigest", "subjects", "governedProviderSet", "digest", "beforeDigest", "afterDigest", "observationStable"],
      "properties": {
        "complete": { "type": "boolean" },
        "invariantDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "beforeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "afterDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "observationStable": { "type": "boolean" },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
        "governedProviderSet": { "type": "array", "items": { "$ref": "#/$defs/providerSubject" } }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "clean", "constitutionVersion", "invariantsDigest", "runnerVersion"],
      "properties": {
        "repository": { "type": "string", "const": "mikeajijola/omniseed-ecosystem" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "clean": { "type": "boolean" },
        "constitutionVersion": { "type": "string", "minLength": 1 },
        "invariantsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "runnerVersion": { "type": "string", "minLength": 1 }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omniform", "omniseed", "omniseedos"],
      "properties": {
        "omniform": { "$ref": "#/$defs/repository" },
        "omniseed": { "$ref": "#/$defs/repository" },
        "omniseedos": { "$ref": "#/$defs/repository" },
        "company": { "$ref": "#/$defs/repository" },
        "githubProvider": { "$ref": "#/$defs/repository" },
        "vercelProvider": { "$ref": "#/$defs/repository" }
      },
      "patternProperties": {
        "^provider_[a-z][a-z0-9_]*$": { "$ref": "#/$defs/repository" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "warnings", "notAutomated"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "notAutomated": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["core", "company", "governance", "provider"] },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "expectedRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "status": { "enum": ["excluded", "unavailable"] },
        "providerId": { "type": "string", "minLength": 1 }, "packageVersion": { "type": "string", "minLength": 1 },
        "packageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "rationale": { "type": "string", "minLength": 1 }
      }, "oneOf": [
        { "properties": { "revision": {} }, "required": ["revision"] },
        { "properties": { "status": { "const": "excluded" }, "rationale": {} }, "required": ["status", "rationale"] },
        { "properties": { "status": { "const": "unavailable" }, "expectedRevision": {}, "rationale": {} }, "required": ["status", "expectedRevision", "rationale"] }
      ]
    },
    "providerSubject": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "status": { "enum": ["included", "excluded"] }, "providerId": { "type": ["string", "null"] }, "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }, "rationale": { "type": ["string", "null"] } },
      "required": ["id", "status", "providerId", "revision", "rationale"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "clean", "path"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "clean": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant", "status", "severity", "repository", "evidence", "test"],
      "properties": {
        "invariant": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "status": { "enum": ["passed", "failed", "warning", "not_automated"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "repository": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 }
      }
    }
  }
}
