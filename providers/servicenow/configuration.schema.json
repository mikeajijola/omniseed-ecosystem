{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseed.org/schemas/providers/servicenow/configuration-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance", "environment", "region", "residencyOffering", "customerConfigurationDigest", "authority", "resources", "complianceArtifacts"],
  "properties": {
    "instance": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "environment": { "enum": ["sandbox", "non_production"] },
    "region": { "type": "string", "minLength": 2 },
    "residencyOffering": { "type": "string", "minLength": 1 },
    "customerConfigurationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["identityDigest", "observe", "mutate"],
      "properties": {
        "identityDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "observe": { "type": "boolean" }, "mutate": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["table", "sysId", "fields"], "properties": {
        "table": { "enum": ["incident", "task"] }, "sysId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      }}
    },
    "complianceArtifacts": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "offering", "reportDate", "source"], "properties": {
        "name": { "type": "string", "minLength": 1 }, "offering": { "type": "string", "minLength": 1 },
        "reportDate": { "type": "string", "format": "date" }, "source": { "type": "string", "format": "uri" }
      }}
    }
  }
}
