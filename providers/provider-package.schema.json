{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseed.org/schemas/provider-package-manifest-v1.json",
  "title": "OmniSeed Provider Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "organisation", "version", "engineCompatibility", "primitiveFamilies", "implementations", "operations", "configurationSchema", "observationTypes", "evidenceTypes", "permissions"],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "organisation": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "engineCompatibility": { "type": "string", "minLength": 1 },
    "primitiveFamilies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["agents", "inference", "skills", "connectors", "workflows", "schedules", "policies", "observations", "memory", "identity", "machines"] } },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "products"],
        "properties": {
          "family": { "enum": ["agents", "inference", "skills", "connectors", "workflows", "schedules", "policies", "observations", "memory", "identity", "machines"] },
          "products": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "operations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "configurationSchema": { "type": "string", "minLength": 1 },
    "observationTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
